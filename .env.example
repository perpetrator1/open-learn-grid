# ============================================================
# Open Learn Grid — Environment Variables
# Copy to .env and fill in all required values.
# Lines marked REQUIRED must be set for production.
# ============================================================

# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-50-chars

DEBUG=False

# Comma-separated list of allowed hostnames
# REQUIRED in production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DJANGO_SETTINGS_MODULE=config.settings.production

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# REQUIRED
POSTGRES_DB=openlearngrid
POSTGRES_USER=olg
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── CORS & CSRF ────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=admin@yourdomain.com

# ── File Storage — S3-compatible (production) ─────────────────────────────────
# Set USE_S3=False to use local disk storage (not recommended for production)
USE_S3=True
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=openlearngrid-media
AWS_S3_REGION_NAME=us-east-1
# Leave blank for AWS S3; set for S3-compatible (Minio, Cloudflare R2, etc.)
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=True
# CDN domain for serving assets (optional: CloudFront, Cloudflare)
AWS_S3_CUSTOM_DOMAIN=

# ── Federation ─────────────────────────────────────────────────────────────────
# REQUIRED — the public domain of this instance (no protocol, no trailing slash)
INSTANCE_DOMAIN=learngrid.yourdomain.com
INSTANCE_NAME=Your University Open Learn Grid
INSTANCE_DESCRIPTION=Academic resource sharing for students and faculty
# REQUIRED — RSA private key (PEM). Generate with:
#   docker compose -f docker-compose.prod.yml run --rm backend python manage.py generate_keypair
INSTANCE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
# Whether new users can self-register
REGISTRATION_OPEN=True
# Whether new registrations require admin approval
REQUIRES_APPROVAL=False

# ── HTTPS Security (set to True in production) ────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ── Sentry Error Tracking (optional) ──────────────────────────────────────────
# Leave blank to disable
SENTRY_DSN=

# ── Cache (optional Redis cache for performance) ───────────────────────────────
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1
