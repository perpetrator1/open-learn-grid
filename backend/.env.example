# ============================================================
# Open Learn Grid — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ENV=local
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True

# ============================================================
# Database (PostgreSQL)
# ============================================================
POSTGRES_DB=openlearngrid_dev
POSTGRES_USER=openlearngrid
POSTGRES_PASSWORD=openlearngrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# Redis / Celery
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Allowed Hosts & CORS
# ============================================================
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Frontend
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# Email
# ============================================================
# Development: use console backend (prints to stdout)
# Production:  use smtp backend with real credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@openlearngrid.local

# ============================================================
# File Storage — S3-compatible (production only)
# ============================================================
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=openlearngrid-uploads
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=True
